---
interface Props {
  id: number | string;
  cod: number;
  nombre: string;
  mostrarEliminar?: boolean;
}

const { id, cod, nombre, mostrarEliminar = false } = Astro.props;

const codigoFormateado = String(cod).padStart(5, '0');
const textoCopiar = `${codigoFormateado}-${nombre}`;
---

<article
  data-centro-card={id}
  data-cod={codigoFormateado}
  data-nombre={nombre.toLowerCase()}
  class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition-all duration-300 p-4 sm:p-5 cursor-pointer"
>
  <div class="flex items-start gap-3">
    <!-- Ícono de institución -->
    <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-400 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
      </svg>
    </div>

    <div class="min-w-0 flex-1">
      <p class="font-mono-ticket text-xs font-semibold text-cyan-700 tracking-wide mb-1">
        {codigoFormateado}
      </p>
      <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 leading-snug">
        {nombre}
      </h3>
    </div>

    <button
      type="button"
      data-copy-btn
      data-copy-text={textoCopiar}
      data-copy-codigo={codigoFormateado}
      data-copy-nombre={nombre}
      aria-label="Copiar código y nombre"
      class="shrink-0 relative w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors flex items-center justify-center overflow-hidden"
    >
      <!-- Ícono copiar -->
      <svg data-icon-copy xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-all duration-200 ease-out" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
      </svg>
      <!-- Ícono check (oculto por defecto, aparece al copiar) -->
      <svg data-icon-check xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600 absolute inset-0 m-auto opacity-0 scale-50 transition-all duration-200 ease-out" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </button>
  </div>

  {mostrarEliminar && (
    <button
      type="button"
      data-delete-centro={id}
      class="w-full mt-3 inline-flex items-center justify-center gap-1.5 rounded-lg border border-red-200 dark:border-red-900 text-red-600 dark:text-red-400 text-xs font-medium py-2 hover:bg-red-50 dark:hover:bg-red-950/40 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
      </svg>
      Eliminar
    </button>
  )}
</article>