---
interface Props {
  id: number | string;
  codce: number | string;
  ce: string;
  fecha: Date | string;
}

const { id, codce, ce, fecha } = Astro.props;

const fechaFormateada = new Date(fecha).toLocaleDateString('es-SV', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<article
  data-ruta-card={id}
  data-codce={String(codce)}
  data-ce={ce.toLowerCase()}
  class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 border-l-4 border-l-amber-500 shadow-sm hover:shadow-md transition-shadow p-4 sm:p-5"
>
  <div class="flex items-start gap-3 mb-3">
    <!-- Ícono de ruta -->
    <div class="shrink-0 w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503-9.65l4.94-2.47A.75.75 0 0121 5.65v13.19a.75.75 0 01-.42.671l-5.08 2.54a.75.75 0 01-.671 0l-5.658-2.829a.75.75 0 00-.671 0l-4.94 2.47A.75.75 0 013 21.03V7.84a.75.75 0 01.42-.671l5.08-2.54a.75.75 0 01.671 0l5.658 2.829a.75.75 0 00.671 0z" />
      </svg>
    </div>

    <div class="min-w-0 flex-1">
      <p class="font-mono-ticket text-xs font-semibold text-amber-700 tracking-wide mb-1">
        {String(codce).padStart(5, '0')}
      </p>
      <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 leading-snug">
        {ce}
      </h3>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-slate-500 pt-3 border-t border-slate-100 dark:border-slate-800 mb-3">
    <span class="inline-flex items-center gap-1.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
      </svg>
      {fechaFormateada}
    </span>
  </div>

  <button
    type="button"
    data-delete-ruta={id}
    class="w-full inline-flex items-center justify-center gap-1.5 rounded-lg border border-red-200 text-red-600 text-xs font-medium py-2 hover:bg-red-50 transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
    </svg>
    Eliminar
  </button>
</article>