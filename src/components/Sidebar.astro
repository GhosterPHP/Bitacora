---
interface Props {
  userEmail?: string | null;
  isAdmin?: boolean;
}
const decoracionesPorMes: Record<string, string> = {
  'Enero': 'https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Travel%20and%20places/Snowflake.png', // Copo de nieve
  'Octubre': 'https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Activities/Jack-O-Lantern.png', // Calabaza de Halloween
  'Diciembre': 'https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Activities/Christmas%20Tree.png', // Árbol de Navidad
};
const estilosPorMes: Record<string, string> = {
  'Enero': 'bg-gradient-to-br from-blue-200 to-cyan-100 border-blue-300 dark:from-blue-800/80 dark:to-cyan-800/60 dark:border-blue-600/50 text-blue-950 dark:text-cyan-50',
  'Octubre': 'bg-gradient-to-br from-orange-200 to-amber-200 border-orange-400 dark:from-orange-800/80 dark:to-amber-700/60 dark:border-orange-500/50 text-orange-950 dark:text-orange-50',
  'Diciembre': 'bg-gradient-to-br from-red-200 to-emerald-100 border-red-300 dark:from-red-900/80 dark:to-emerald-800/60 dark:border-red-700/50 text-slate-900 dark:text-emerald-50',
};


const { userEmail = null, isAdmin = false } = Astro.props;

// Genera iniciales a partir del email (ej. "ana.lopez@empresa.com" -> "AL")
function getIniciales(email: string | null) {
  if (!email) return '??';
  const nombre = email.split('@')[0];
  const partes = nombre.split(/[.\-_]/).filter(Boolean);
  const iniciales = partes.slice(0, 2).map((p) => p[0]?.toUpperCase() ?? '');
  return iniciales.join('') || email[0].toUpperCase();
}

const iniciales = getIniciales(userEmail);

const rutaActual = Astro.url.pathname;

// --- Reloj: hora inicial (se actualiza cada segundo por JS) ---
const horaInicial = new Date().toLocaleTimeString('es-SV', {
  timeZone: 'America/El_Salvador',
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
  hour12: false,
});

// --- Calendario: mes actual con el día de hoy resaltado ---
const partesFecha = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/El_Salvador',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).formatToParts(new Date());

const obtenerParte = (tipo: string) => Number(partesFecha.find((p) => p.type === tipo)?.value);
const anioActual = obtenerParte('year');
const mesActual = obtenerParte('month'); // 1-12
const diaHoy = obtenerParte('day');

const nombreMes = new Date(anioActual, mesActual - 1, 1)
  .toLocaleDateString('es-ES', { month: 'long' })
  .replace(/^\w/, (c) => c.toUpperCase());

const diasEnMes = new Date(anioActual, mesActual, 0).getDate();
const primerDiaSemana = new Date(anioActual, mesActual - 1, 1).getDay(); // 0 = domingo
const diasSemana = ['D', 'L', 'M', 'M', 'J', 'V', 'S'];

const celdasCalendario: (number | null)[] = [
  ...Array(primerDiaSemana).fill(null),
  ...Array.from({ length: diasEnMes }, (_, i) => i + 1),
];
const decoracionImg = decoracionesPorMes[nombreMes];
// Verificamos si el mes actual es uno de los 3 especiales
const esMesEspecial = !!estilosPorMes[nombreMes];

// Si es especial, usamos el degradado. Si es normal, usamos tus colores originales.
const degradadoActual = estilosPorMes[nombreMes] || 'bg-slate-800/60 dark:bg-white border-slate-800 dark:border-slate-300';
// Ajusta los href a las rutas reales conforme las vayas creando
const menuItems = [
  { label: 'Tickets', href: '/', icon: 'ticket' },
  { label: 'Rutas', href: '/rutas', icon: 'route' },
  { label: 'Centros Escolares', href: '/centros-escolares', icon: 'building' },
  { label: 'Reportes', href: '/reportes', icon: 'chart' },
  { label: 'Herramientas', href: '/herramientas', icon: 'tool'},
  { label: 'Configuración', href: '/configuracion', icon: 'gear' },
].map((item) => ({
  ...item,
  active: item.href === '/' ? rutaActual === '/' : rutaActual.startsWith(item.href),
}));

const icons: Record<string, string> = {
  ticket: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  route: 'M9 6.75V15m6-6v8.25m.503-9.65l4.94-2.47A.75.75 0 0121 5.65v13.19a.75.75 0 01-.42.671l-5.08 2.54a.75.75 0 01-.671 0l-5.658-2.829a.75.75 0 00-.671 0l-4.94 2.47A.75.75 0 013 21.03V7.84a.75.75 0 01.42-.671l5.08-2.54a.75.75 0 01.671 0l5.658 2.829a.75.75 0 00.671 0z',
  building: 'M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  gear: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z',
  tool: 'M21.75 6.75a4.5 4.5 0 0 1-4.884 4.484c-1.076-.091-2.264.071-2.95.904l-7.152 8.684a2.548 2.548 0 1 1-3.586-3.586l8.684-7.152c.833-.686.995-1.874.904-2.95a4.5 4.5 0 0 1 6.336-4.486l-3.276 3.276a3.004 3.004 0 0 0 2.25 2.25l3.276-3.276c.256.565.398 1.192.398 1.852Z M4.867 19.125h.008v.008h-.008v-.008Z',
}
---

<!--
  Esquema de color INVERTIDO respecto al resto de la app:
  - Tema claro global -> sidebar OSCURO (slate-900), como siempre.
  - Tema oscuro global -> sidebar CLARO (blanco), para que siempre
    haya contraste y se distinga del contenido principal.
-->
<aside
  id="sidebar"
  class="fixed lg:sticky top-0 left-0 z-40 h-screen w-64 shrink-0 -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-out bg-slate-900 dark:bg-slate-200 text-slate-300 dark:text-slate-600 flex flex-col"
>
 <!-- Marca -->
  <div class="flex items-center gap-2.5 px-4 h-16 border-b border-slate-800 dark:border-slate-300 shrink-0">
    <a href="/" class="flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 rounded-lg p-1 transition-all" aria-label="Ir a inicio">
      <img 
        src="/chirrete.png" 
        alt="Bitácora Chirrete Logo" 
        class="h-14 w-full object-contain select-none dark:brightness-95 transition-all"
        draggable="false"
      />
    </a>
  </div>

<!-- Reloj (hora de El Salvador) -->
<div class="flex items-center gap-3.5 px-5 py-4 border-b border-slate-800/80 dark:border-slate-200/80 shrink-0 group cursor-default">
  
  <!-- Contenedor del Icono -->
  <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-slate-800/60 dark:bg-slate-100 border border-slate-700/50 dark:border-slate-300 shadow-sm shrink-0 transition-transform duration-300 group-hover:scale-105">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400 dark:text-cyan-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    
    <!-- Indicador "En vivo" (Punto verde que palpita) -->
    <span class="absolute -top-1 -right-1 flex h-3 w-3">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500 border-2 border-slate-900 dark:border-white"></span>
    </span>
  </div>

  <!-- Contenedor de Texto -->
  <div class="flex flex-col justify-center">
    <!-- Fuente minimalista: font-sans y font-light -->
    <span id="reloj-el-salvador" class="font-sans text-[17px] font-light text-white dark:text-slate-800 tracking-wider tabular-nums leading-none mb-1.5">
      {horaInicial}
    </span>
    <span class="text-[9px] text-slate-400 dark:text-slate-500 font-medium uppercase tracking-widest leading-none">
      Hora de El Salvador
    </span>
  </div>

</div>

  <!-- Navegación -->
  <nav class="flex-1 min-h-0 overflow-y-auto sin-scrollbar px-3 py-3 space-y-1">
    {menuItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          'flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors',
          item.active
            ? 'bg-slate-800 dark:bg-white text-white dark:text-slate-900 border-l-2 border-cyan-400 dark:border-cyan-600 -ml-[2px] pl-[calc(0.75rem+2px)]'
            : 'text-slate-400 dark:text-slate-500 hover:bg-slate-800/60 dark:hover:bg-slate-300 hover:text-white dark:hover:text-slate-900',
        ]}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d={icons[item.icon]} />
        </svg>
        <span>{item.label}</span>
      </a>
    ))}

  <!-- Calendario minimalista (Easter eggs en Oct, Dic, Ene / Normal el resto del año) -->
    <div class:list={["mt-3 px-2 py-2.5 rounded-xl border", degradadoActual]}>
      
      <!-- Cabecera -->
      <div class="flex items-center justify-between mb-1.5 px-1">
        <p class:list={[
          "text-[11px] font-semibold tracking-wide",
          esMesEspecial ? "opacity-90" : "text-slate-300 dark:text-slate-600"
        ]}>
          {nombreMes} {anioActual}
        </p>
        
        {decoracionImg && (
          <img 
            src={decoracionImg} 
            alt={`Decoración de ${nombreMes}`} 
            title={`Decoración de ${nombreMes}`}
            class="w-6 h-6 object-contain select-none"
            draggable="false"
          />
        )}
      </div>

      <div class="grid grid-cols-7 gap-y-0.5 text-center">
        <!-- Letras de los días -->
        {diasSemana.map((d) => (
          <span class:list={[
            "text-[10px]",
            esMesEspecial ? "opacity-60 font-medium" : "text-slate-500 dark:text-slate-400"
          ]}>
            {d}
          </span>
        ))}
        
        <!-- Números de los días -->
        {celdasCalendario.map((dia) => (
          dia === null ? (
            <span></span>
          ) : (
            <span
              class:list={[
                'text-[10px] w-5 h-5 rounded-full flex items-center justify-center mx-auto transition-colors',
                dia === diaHoy
                  // Estilo para el DÍA ACTUAL
                  ? (esMesEspecial 
                      ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-sm font-bold' 
                      : 'bg-cyan-400 dark:bg-cyan-600 text-slate-900 dark:text-white font-semibold')
                  // Estilo para los DEMÁS DÍAS
                  : (esMesEspecial 
                      ? 'opacity-80 hover:opacity-100 hover:bg-black/5 dark:hover:bg-white/10' 
                      : 'text-slate-400 dark:text-slate-500')
              ]}
            >
              {dia}
            </span>
          )
        ))}
      </div>
    </div>
  </nav>

  <!-- Usuario -->
  <div class="px-3 py-4 border-t border-slate-800 dark:border-slate-300 shrink-0">
    <!-- Badges de rol -->
    <div class="flex flex-wrap items-center gap-1.5 px-2 mb-2">
      {isAdmin && (
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-cyan-400/20 dark:bg-cyan-100 text-cyan-300 dark:text-cyan-700">
          Administrador
        </span>
      )}
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-700 dark:bg-white text-slate-300 dark:text-slate-600">
        Técnico
      </span>
    </div>

    <div class="flex items-center gap-3 px-2 py-2">
      <div class="w-9 h-9 rounded-full bg-slate-700 dark:bg-white flex items-center justify-center text-sm font-semibold text-white dark:text-slate-700 shrink-0">
        {iniciales}
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium text-white dark:text-slate-900 truncate">{userEmail ?? 'Sesión no identificada'}</p>
        <p class="text-xs text-cyan-300 dark:text-cyan-800 truncate">Agente de soporte</p>
      </div>
      <form method="POST" action="/api/session?_method=DELETE" data-logout-form>
        <button
          type="submit"
          aria-label="Cerrar sesión"
          class="p-1.5 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-800 dark:hover:bg-slate-300 hover:text-white dark:hover:text-slate-900 transition-colors shrink-0"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</aside>

<script>
  document.querySelector('[data-logout-form]')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    await fetch('/api/session', { method: 'DELETE' });
    window.location.href = '/login';
  });

  // Reloj en vivo con la hora de El Salvador. Respeta el formato
  // 12h/24h guardado en Configuración (localStorage + evento en
  // vivo cuando se cambia desde esa página).
  const relojEl = document.getElementById('reloj-el-salvador');

  function getFormatoHora(): '12h' | '24h' {
    const valor = localStorage.getItem('formatoHora');
    return valor === '12h' ? '12h' : '24h';
  }

  function actualizarReloj() {
    if (!relojEl) return;
    const formato = getFormatoHora();
    relojEl.textContent = new Date().toLocaleTimeString('es-SV', {
      timeZone: 'America/El_Salvador',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: formato === '12h',
    });
  }

  actualizarReloj();
  setInterval(actualizarReloj, 1000);

  // Si cambian el formato desde Configuración mientras el sidebar
  // está visible, se actualiza al instante sin esperar al siguiente tick.
  window.addEventListener('formato-reloj-cambiado', actualizarReloj);
</script>