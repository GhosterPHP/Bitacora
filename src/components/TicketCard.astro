---
interface Props {
  id: number | string;
  numTicket: string;
  tipoUsuario: 'Estudiante' | 'Docente';
  centroEducativo: string;
  codce: number | string;
  fecha: Date | string;
}

const { id, numTicket, tipoUsuario, centroEducativo, codce, fecha } = Astro.props;

const tipoConfig = {
  Estudiante: {
    border: 'border-l-indigo-500',
    badge: 'bg-indigo-50 text-indigo-700 border-indigo-200/80 dark:bg-indigo-950/40 dark:text-indigo-300 dark:border-indigo-800/60',
    iconBg: 'bg-indigo-50 text-indigo-600 ring-1 ring-indigo-200/60 dark:bg-indigo-950/60 dark:text-indigo-400 dark:ring-indigo-800/50',
    dot: 'bg-indigo-500',
    icon: 'graduation',
  },
  Docente: {
    border: 'border-l-emerald-500',
    badge: 'bg-emerald-50 text-emerald-700 border-emerald-200/80 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800/60',
    iconBg: 'bg-emerald-50 text-emerald-600 ring-1 ring-emerald-200/60 dark:bg-emerald-950/60 dark:text-emerald-400 dark:ring-emerald-800/50',
    dot: 'bg-emerald-500',
    icon: 'person',
  },
};

const cfg = tipoConfig[tipoUsuario] ?? tipoConfig.Estudiante;

const fechaFormateada = new Date(fecha).toLocaleDateString('es-SV', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<article
  data-ticket-card={id}
  class:list={[
    'group relative bg-white dark:bg-slate-800/40 rounded-xl border border-slate-200/80 dark:border-slate-800 border-l-[3.5px] p-4 shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer flex flex-col justify-between gap-3.5',
    cfg.border,
  ]}
>
  <div>
    <!-- Encabezado de la Card -->
    <div class="flex items-center justify-between gap-2.5 mb-3.5">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class:list={['flex h-9 w-9 items-center justify-center rounded-lg shrink-0', cfg.iconBg]}>
          {cfg.icon === 'graduation' ? (
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
            </svg>
          ) : (
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          )}
        </div>

        <div class="min-w-0">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
            Ticket
          </span>
          <span class="font-mono text-xs sm:text-[13px] font-bold text-slate-800 dark:text-slate-100 tracking-tight block truncate">
            {numTicket}
          </span>
        </div>
      </div>

      <!-- Badge de Tipo -->
      <span class:list={['inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border', cfg.badge]}>
        <span class:list={['h-1.5 w-1.5 rounded-full animate-pulse', cfg.dot]}></span>
        {tipoUsuario}
      </span>
    </div>

    <!-- Información del Centro -->
    <div class="space-y-2">
      <div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">
          Centro Educativo
        </span>
        <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-200 line-clamp-2 leading-snug group-hover:text-slate-900 dark:group-hover:text-white transition-colors">
          <span class="font-mono text-xs font-medium px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 mr-1.5">
            {codce}
          </span>
          {centroEducativo}
        </h3>
      </div>

      <div class="inline-flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
        <span class="capitalize">{fechaFormateada}</span>
      </div>
    </div>
  </div>

  <!-- Botones de Acción -->
  <div class="flex items-center gap-2 pt-3 border-t border-slate-100 dark:border-slate-800/80">
    <a
      href={`/tickets/editar/${id}`}
      class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-medium py-2 hover:bg-slate-50 dark:hover:bg-slate-750 hover:text-slate-900 dark:hover:text-white transition-colors focus:ring-2 focus:ring-slate-400/20 outline-none"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
      </svg>
      Editar
    </a>
    <button
      type="button"
      data-delete-ticket={id}
      class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-red-200/80 dark:border-red-900/40 bg-red-50/50 dark:bg-red-950/20 text-red-600 dark:text-red-400 text-xs font-medium py-2 hover:bg-red-100/60 dark:hover:bg-red-900/40 hover:text-red-700 dark:hover:text-red-300 transition-colors focus:ring-2 focus:ring-red-400/20 outline-none"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
      </svg>
      Eliminar
    </button>
  </div>
</article>

<script>
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    const deleteBtn = target.closest('[data-delete-ticket]') as HTMLElement | null;
    if (deleteBtn) {
      const id = deleteBtn.dataset.deleteTicket;
      const confirmado = confirm('¿Eliminar este ticket? Esta acción no se puede deshacer.');
      if (!confirmado) return;

      const res = await fetch(`/api/tickets/${id}`, { method: 'DELETE' });

      if (res.ok) {
        deleteBtn.closest('article')?.remove();
      } else {
        alert('No se pudo eliminar el ticket.');
      }
      return;
    }

    if (target.closest('a, button')) return;

    const card = target.closest('[data-ticket-card]') as HTMLElement | null;
    if (card) {
      window.location.href = `/tickets/${card.dataset.ticketCard}`;
    }
  });
</script>