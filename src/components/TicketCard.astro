---
interface Props {
  id: number | string;
  numTicket: string;
  tipoUsuario: 'Estudiante' | 'Docente';
  centroEducativo: string;
  codce: number | string;
  fecha: Date | string;
}

const { id, numTicket, tipoUsuario, centroEducativo, codce, fecha } = Astro.props;

const tipoConfig: Record<string, { border: string; badge: string; iconBg: string; icon: string }> = {
  Estudiante: {
    border: 'border-l-indigo-500',
    badge: 'bg-indigo-50 text-indigo-700 border border-indigo-200',
    iconBg: 'bg-indigo-100 text-indigo-700',
    icon: 'graduation',
  },
  Docente: {
    border: 'border-l-teal-500',
    badge: 'bg-teal-50 text-teal-700 border border-teal-200',
    iconBg: 'bg-teal-100 text-teal-700',
    icon: 'person',
  },
};

const cfg = tipoConfig[tipoUsuario] ?? tipoConfig.Estudiante;

const fechaFormateada = new Date(fecha).toLocaleDateString('es-SV', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<article
  data-ticket-card={id}
  class:list={[
    'group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 border-l-4 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 p-3.5 sm:p-4 cursor-pointer',
    cfg.border,
  ]}
>
  <div class="flex items-start justify-between gap-2.5 mb-3">
    <div class="flex items-center gap-2 min-w-0">
      <div class:list={['flex h-8 w-8 items-center justify-center rounded-lg shrink-0', cfg.iconBg]}>
        {cfg.icon === 'graduation' ? (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.8 w-3.8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 2 8l10 5 10-5-10-5Z" />
            <path d="M6 10.5V15c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.5" />
            <path d="M12 13v8" />
          </svg>
        ) : (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.8 w-3.8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="10" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
        )}
      </div>
      <div class="rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-1.5 min-w-0">
        <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-500">Ticket</div>
        <div class="font-mono-ticket text-[12px] sm:text-[13px] font-bold text-slate-800 dark:text-slate-100 break-all">
          {numTicket}
        </div>
      </div>
    </div>

    <span class:list={['inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold', cfg.badge]}>
      <span class:list={['h-1.5 w-1.5 rounded-full', tipoUsuario === 'Estudiante' ? 'bg-indigo-500' : 'bg-teal-500']}>
      </span>
      {tipoUsuario}
    </span>
  </div>

  <div class="space-y-2.5">
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-500 mb-1">
        Centro educativo
      </p>
      <h3 class="text-[15px] font-semibold text-slate-900 dark:text-slate-100 leading-5 line-clamp-2">
        <span class="font-mono-ticket text-[12px] sm:text-[13px] text-slate-500 dark:text-slate-400 mr-1.5">
          {codce}
        </span>
        - {centroEducativo}
      </h3>
    </div>

    <div class="pt-0.5">
      <div class="inline-flex items-center gap-1.5 text-[12px] sm:text-[13px] font-semibold text-slate-700 dark:text-slate-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 2v4" />
          <path d="M16 2v4" />
          <rect x="3" y="5" width="18" height="17" rx="2" />
          <path d="M3 10h18" />
        </svg>
        {fechaFormateada}
      </div>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-2.5 mt-3 border-t border-slate-100 dark:border-slate-800">
    <a
      href={`/tickets/editar/${id}`}
      class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 text-[11px] font-medium py-2 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
      </svg>
      Editar
    </a>
    <button
      type="button"
      data-delete-ticket={id}
      class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-red-200 text-red-600 text-[11px] font-medium py-2 hover:bg-red-50 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
      </svg>
      Eliminar
    </button>
  </div>
</article>

<script>
  // Delegación de eventos: como las cards se generan en un loop,
  // un solo listener en el documento cubre todas.
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // Botón "Eliminar"
    const deleteBtn = target.closest('[data-delete-ticket]') as HTMLElement | null;
    if (deleteBtn) {
      const id = deleteBtn.dataset.deleteTicket;
      const confirmado = confirm('¿Eliminar este ticket? Esta acción no se puede deshacer.');
      if (!confirmado) return;

      const res = await fetch(`/api/tickets/${id}`, { method: 'DELETE' });

      if (res.ok) {
        deleteBtn.closest('article')?.remove();
      } else {
        alert('No se pudo eliminar el ticket.');
      }
      return;
    }

    // Si el click fue sobre cualquier link o botón (editar, ver imagen,
    // eliminar), dejamos que ese elemento maneje su propia acción y no
    // navegamos a la vista de detalle.
    if (target.closest('a, button')) return;

    // Click en cualquier otra parte de la card -> ir al detalle
    const card = target.closest('[data-ticket-card]') as HTMLElement | null;
    if (card) {
      window.location.href = `/tickets/${card.dataset.ticketCard}`;
    }
  });
</script>