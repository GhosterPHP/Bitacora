---
interface Props {
  id: number | string;
  numTicket: string;
  tipoUsuario: 'Estudiante' | 'Docente';
  centroEducativo: string;
  codce: number | string;
  fecha: Date | string;
}

const { id, numTicket, tipoUsuario, centroEducativo, codce, fecha } = Astro.props;

const tipoConfig: Record<string, { dot: string; border: string; badge: string }> = {
  Estudiante: {
    dot: 'bg-indigo-500',
    border: 'border-l-indigo-500',
    badge: 'bg-indigo-50 text-indigo-700',
  },
  Docente: {
    dot: 'bg-teal-500',
    border: 'border-l-teal-500',
    badge: 'bg-teal-50 text-teal-700',
  },
};

const cfg = tipoConfig[tipoUsuario] ?? tipoConfig.Estudiante;

const fechaFormateada = new Date(fecha).toLocaleDateString('es-SV', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<article
  data-ticket-card={id}
  class:list={[
    'bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 border-l-4 shadow-sm hover:shadow-md transition-shadow p-4 sm:p-5 cursor-pointer',
    cfg.border,
  ]}
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <span class="font-mono-ticket text-xs font-semibold text-slate-500 tracking-wide">
      {numTicket}
    </span>
    <span class:list={['inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium', cfg.badge]}>
      <span class:list={['w-1.5 h-1.5 rounded-full', cfg.dot]}></span>
      {tipoUsuario}
    </span>
  </div>

  <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-1 line-clamp-2">
    {centroEducativo}
  </h3>
  <p class="font-mono-ticket text-xs text-slate-400 mb-3">
    Código: {codce}
  </p>

  <div class="flex items-center text-xs text-slate-500 pt-3 border-t border-slate-100 dark:border-slate-800 mb-3">
    <span>{fechaFormateada}</span>
  </div>

  <div class="flex items-center gap-2 pt-3 border-t border-slate-100 dark:border-slate-800">
    <a
      href={`/tickets/editar/${id}`}
      class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 text-xs font-medium py-2 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
      </svg>
      Editar
    </a>
    <button
      type="button"
      data-delete-ticket={id}
      class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-red-200 text-red-600 text-xs font-medium py-2 hover:bg-red-50 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
      </svg>
      Eliminar
    </button>
  </div>
</article>

<script>
  // Delegación de eventos: como las cards se generan en un loop,
  // un solo listener en el documento cubre todas.
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // Botón "Eliminar"
    const deleteBtn = target.closest('[data-delete-ticket]') as HTMLElement | null;
    if (deleteBtn) {
      const id = deleteBtn.dataset.deleteTicket;
      const confirmado = confirm('¿Eliminar este ticket? Esta acción no se puede deshacer.');
      if (!confirmado) return;

      const res = await fetch(`/api/tickets/${id}`, { method: 'DELETE' });

      if (res.ok) {
        deleteBtn.closest('article')?.remove();
      } else {
        alert('No se pudo eliminar el ticket.');
      }
      return;
    }

    // Si el click fue sobre cualquier link o botón (editar, ver imagen,
    // eliminar), dejamos que ese elemento maneje su propia acción y no
    // navegamos a la vista de detalle.
    if (target.closest('a, button')) return;

    // Click en cualquier otra parte de la card -> ir al detalle
    const card = target.closest('[data-ticket-card]') as HTMLElement | null;
    if (card) {
      window.location.href = `/tickets/${card.dataset.ticketCard}`;
    }
  });
</script>