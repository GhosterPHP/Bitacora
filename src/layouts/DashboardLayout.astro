---
import Sidebar from '../components/Sidebar.astro';
import { AVISO_ACTUAL } from '../lib/avisos';

interface Props {
  title?: string;
}

const { title = 'Panel de Tickets' } = Astro.props;

// Disponible gracias al middleware (src/middleware.ts), que ya
// resolvió la sesión de Supabase Auth para esta petición.
const userEmail = Astro.locals.user?.email ?? null;
const { supabase, user, isAdmin } = Astro.locals;

// --- ¿Ya leyó el aviso actual? Solo se consulta si hay sesión. ---
let mostrarAviso = false;
if (user) {
  const { data: yaLeido } = await supabase
    .from('avisos_leidos')
    .select('aviso_id')
    .eq('usuario', user.id)
    .eq('aviso_id', AVISO_ACTUAL.id)
    .maybeSingle();

  mostrarAviso = !yaLeido;
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Se ejecuta ANTES de pintar la página, para que no haya un
      // parpadeo de tema claro -> oscuro al cargar. Lee la preferencia
      // guardada; si no hay ninguna, respeta el modo del sistema.
      (function () {
        const guardado = localStorage.getItem('tema');
        const prefiereOscuro = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const oscuro = guardado ? guardado === 'oscuro' : prefiereOscuro;
        document.documentElement.classList.toggle('dark', oscuro);
      })();
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-zinc-950 text-slate-900 dark:text-zinc-100 font-sans antialiased transition-colors">
    <div class="min-h-screen flex">
      <!-- Overlay para móvil -->
      <div
        id="sidebar-overlay"
        class="fixed inset-0 bg-slate-900/50 z-30 hidden lg:hidden"
      ></div>

      <Sidebar userEmail={userEmail} isAdmin={isAdmin} />

      <!-- Contenido principal -->
      <div class="flex-1 flex flex-col min-w-0">
        <!-- Topbar móvil -->
        <header class="lg:hidden sticky top-0 z-20 flex items-center gap-3 bg-white dark:bg-zinc-900 border-b border-slate-200 dark:border-zinc-800 px-4 py-3">
          <button
            id="sidebar-toggle"
            aria-label="Abrir menú"
            class="p-2 -ml-2 rounded-lg text-slate-600 dark:text-zinc-300 hover:bg-slate-100 dark:hover:bg-zinc-800 active:bg-slate-200 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
          </button>
          <span class="font-semibold text-slate-900 dark:text-cyan-400">{title}</span>
        </header>

        <main class="flex-1 p-4 sm:p-6 lg:p-8">
          <slot />
        </main>
      </div>
    </div>

    <!-- Modal de aviso de novedades -->
    {mostrarAviso && (
      <div id="aviso-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 dark:bg-slate-950/60 backdrop-blur-sm px-4 p-4 transition-opacity duration-300">
        
        <!-- Contenedor principal con efecto de elevación y bordes suaves -->
        <div class="relative w-full max-w-md bg-white dark:bg-slate-900 rounded-[2rem] border border-slate-200/80 dark:border-slate-800 shadow-2xl overflow-hidden">
          
          <!-- Brillo decorativo superior -->
          <div class="absolute top-0 inset-x-0 h-32 bg-gradient-to-b from-cyan-100/50 to-transparent dark:from-cyan-900/20 dark:to-transparent pointer-events-none"></div>

          <div class="relative p-6 sm:p-8">
            <!-- Encabezado: Icono + Título -->
            <div class="flex items-center gap-4 mb-6">
              <div class="shrink-0 w-12 h-12 rounded-2xl bg-gradient-to-br from-cyan-400 to-cyan-600 flex items-center justify-center shadow-lg shadow-cyan-500/30">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" />
                </svg>
              </div>
              <div>
                <span class="inline-block px-2.5 py-0.5 rounded-full bg-cyan-50 dark:bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 text-[10px] font-bold uppercase tracking-wider mb-1 border border-cyan-100 dark:border-cyan-500/20">
                  Nueva Versión
                </span>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white leading-tight">
                  {AVISO_ACTUAL.titulo}
                </h2>
              </div>
            </div>

            <!-- Caja contenedora de los cambios (mejora la lectura) -->
            <div class="bg-slate-50 dark:bg-slate-800/40 rounded-2xl p-5 mb-6 border border-slate-100 dark:border-slate-800/60">
              <ul class="space-y-3.5">
                {AVISO_ACTUAL.cambios.map((cambio) => (
                  <li class="flex items-start gap-3 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                    <div class="shrink-0 w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center mt-0.5">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                      </svg>
                    </div>
                    <span>{cambio}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Botón de acción con efecto hover y click -->
            <button
              id="btn-aviso-leido"
              data-aviso-id={AVISO_ACTUAL.id}
              class="group w-full flex items-center justify-center gap-2 rounded-xl bg-slate-900 dark:bg-cyan-600 hover:bg-slate-800 dark:hover:bg-cyan-500 text-white text-sm font-semibold px-4 py-3.5 transition-all shadow-md active:scale-[0.98]"
            >
              <span>Entendido</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    )}

    <script>
      const toggle = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebar-overlay');

      function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        overlay?.classList.remove('hidden');
      }
      function closeSidebar() {
        sidebar?.classList.add('-translate-x-full');
        overlay?.classList.add('hidden');
      }

      toggle?.addEventListener('click', openSidebar);
      overlay?.addEventListener('click', closeSidebar);

      // Modal de aviso: al confirmar, se marca como leído en la base
      // de datos y se cierra sin recargar la página.
      const btnAvisoLeido = document.getElementById('btn-aviso-leido');
      const avisoOverlay = document.getElementById('aviso-overlay');

      btnAvisoLeido?.addEventListener('click', async () => {
        const avisoId = btnAvisoLeido.getAttribute('data-aviso-id');
        try {
          await fetch('/api/avisos/leido', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ avisoId }),
          });
        } catch (err) {
          console.error('No se pudo marcar el aviso como leído:', err);
        }
        avisoOverlay?.remove();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Inter', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }
  body {
    font-family: var(--font-sans);
  }
  .font-mono-ticket {
    font-family: var(--font-mono);
  }
  /* Oculta visualmente la barra de scroll mientras el contenido
     sigue siendo desplazable (útil para el sidebar). */
  .sin-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .sin-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>