---
export const prerender = false;

import DashboardLayout from '../layouts/DashboardLayout.astro';
import CentroCard from '../components/CentroCard.astro';
import '../styles/global.css';

const { supabase, isAdmin } = Astro.locals;

const { data, error } = await supabase
  .from('centroseducativos')
  .select('id, cod, nombre')
  .order('nombre', { ascending: true });

const centros = data ?? [];
---

<DashboardLayout title="Centros Escolares">
  <div class="max-w-7xl mx-auto">
    <!-- Encabezado -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100">Centros Escolares</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Directorio de centros registrados</p>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="btn-ayuda-centros"
          type="button"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a2.25 2.25 0 100 4.5 2.25 2.25 0 000-4.5zm-4.5 9.75c0-2.485 2.015-4.5 4.5-4.5s4.5 2.015 4.5 4.5" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3.75a8.25 8.25 0 100 16.5 8.25 8.25 0 000-16.5z" />
          </svg>
          Ayuda
        </button>
        <a href="/centros-escolares/nuevo" class="inline-flex items-center justify-center gap-2 bg-slate-900 dark:bg-cyan-600 hover:bg-slate-800 dark:hover:bg-cyan-500 text-white text-sm font-medium px-4 py-2.5 rounded-lg transition-colors shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Nuevo centro
        </a>
      </div>
    </div>

    {error && (
      <div class="mb-6 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3">
        No se pudieron cargar los centros educativos.
      </div>
    )}

    <!-- Buscador -->
    <div class="relative mb-6 max-w-md">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
      <input
        id="buscador-centros"
        type="text"
        placeholder="Buscar por código o nombre..."
        class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 pl-10 pr-4 py-2.5 text-sm text-slate-900 dark:text-slate-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900"
      />
    </div>

    <!-- Grid de centros -->
    <div id="grid-centros" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
      {centros.map((centro) => (
        <CentroCard id={centro.id} cod={centro.cod} nombre={centro.nombre} mostrarEliminar={isAdmin} />
      ))}
    </div>

    <p id="sin-resultados" class="hidden text-center text-slate-500 text-sm py-16">
      No se encontraron centros que coincidan con tu búsqueda.
    </p>

    {centros.length === 0 && !error && (
      <div class="text-center py-16">
        <p class="text-slate-500">Aún no hay centros educativos registrados.</p>
        <p class="text-slate-400 text-sm mt-1">Se agregan automáticamente al crear tickets.</p>
      </div>
    )}
  </div>

  <div id="ayuda-centros-modal" class="fixed inset-0 z-50 hidden bg-slate-900/60 px-4 py-6 items-center justify-center">
    <div class="w-full max-w-lg rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xl">
      <div class="flex items-start justify-between gap-4 border-b border-slate-200 dark:border-slate-800 px-5 py-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-cyan-600 dark:text-cyan-400">Guía rápida</p>
          <h2 class="mt-1 text-xl font-bold text-slate-900 dark:text-slate-100">Centros escolares</h2>
        </div>
        <button
          id="cerrar-ayuda-centros"
          type="button"
          aria-label="Cerrar ayuda"
          class="rounded-lg p-2 text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 dark:text-slate-300 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="p-5 space-y-4 text-sm text-slate-600 dark:text-slate-300">
        <div class="rounded-xl bg-slate-50 dark:bg-slate-800/80 p-3">
          <p class="font-semibold text-slate-900 dark:text-slate-100 mb-1">1. Directorio general</p>
          <p>Este listado muestra todos los centros escolares registrados por el sistema, incluyendo los creados por distintos usuarios.</p>
        </div>

        <div class="rounded-xl bg-slate-50 dark:bg-slate-800/80 p-3">
          <p class="font-semibold text-slate-900 dark:text-slate-100 mb-1">2. Búsqueda ágil</p>
          <p>Se puede buscar fácilmente por <span class="font-medium text-slate-900 dark:text-slate-100">nombre</span> o por <span class="font-medium text-slate-900 dark:text-slate-100">código</span> para localizar un centro de forma rápida.</p>
        </div>

        <div class="rounded-xl bg-slate-50 dark:bg-slate-800/80 p-3">
          <p class="font-semibold text-slate-900 dark:text-slate-100 mb-1">3. Registro de centros</p>
          <p>Se pueden agregar nuevos centros en cualquier momento según sea necesario, sin limitar la operación a una fecha o proceso específico.</p>
        </div>

        <div class="rounded-xl bg-slate-50 dark:bg-slate-800/80 p-3">
          <p class="font-semibold text-slate-900 dark:text-slate-100 mb-1">4. Copia rápida</p>
          <p>El botón de copiar prepara el código en el formato <span class="font-medium text-slate-900 dark:text-slate-100">13384-CENTRO ESCOLAR CANTON ALTO EL ROBLE</span>, listo para pegar en otros registros o documentos.</p>
        </div>
      </div>

      <div class="border-t border-slate-200 dark:border-slate-800 px-5 py-4 flex justify-end">
        <button
          id="confirmar-ayuda-centros"
          type="button"
          class="rounded-lg bg-slate-900 dark:bg-cyan-600 hover:bg-slate-800 dark:hover:bg-cyan-500 px-4 py-2 text-sm font-medium text-white transition-colors"
        >
          Entendido
        </button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import Swal from 'sweetalert2';

  const modalAyudaCentros = document.getElementById('ayuda-centros-modal');
  const btnAbrirAyudaCentros = document.getElementById('btn-ayuda-centros');
  const btnCerrarAyudaCentros = document.getElementById('cerrar-ayuda-centros');
  const btnConfirmarAyudaCentros = document.getElementById('confirmar-ayuda-centros');

  const abrirAyudaCentros = () => {
    modalAyudaCentros?.classList.remove('hidden');
    modalAyudaCentros?.classList.add('flex');
  };
  const cerrarAyudaCentros = () => {
    modalAyudaCentros?.classList.add('hidden');
    modalAyudaCentros?.classList.remove('flex');
  };

  btnAbrirAyudaCentros?.addEventListener('click', abrirAyudaCentros);
  btnCerrarAyudaCentros?.addEventListener('click', cerrarAyudaCentros);
  btnConfirmarAyudaCentros?.addEventListener('click', cerrarAyudaCentros);

  modalAyudaCentros?.addEventListener('click', (event) => {
    if (event.target === modalAyudaCentros) {
      cerrarAyudaCentros();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modalAyudaCentros && !modalAyudaCentros.classList.contains('hidden')) {
      cerrarAyudaCentros();
    }
  });

  // Configuración de un "toast" reutilizable con SweetAlert2: pequeño,
  // en la esquina, se autocierra y con barra de progreso.
  const Toast = Swal.mixin({
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 2000,
    timerProgressBar: true,
    didOpen: (toast) => {
      toast.onmouseenter = Swal.stopTimer;
      toast.onmouseleave = Swal.resumeTimer;
    },
  });

  // --- Buscador (filtra por código o nombre, sin recargar la página) ---
  const input = document.getElementById('buscador-centros') as HTMLInputElement | null;
  const grid = document.getElementById('grid-centros');
  const sinResultados = document.getElementById('sin-resultados');

  input?.addEventListener('input', () => {
    const termino = input.value.trim().toLowerCase();
    const cards = grid?.querySelectorAll<HTMLElement>('[data-centro-card]') ?? [];
    let visibles = 0;

    cards.forEach((card) => {
      const cod = card.dataset.cod ?? '';
      const nombre = card.dataset.nombre ?? '';
      const coincide = cod.includes(termino) || nombre.includes(termino);
      card.classList.toggle('hidden', !coincide);
      if (coincide) visibles++;
    });

    sinResultados?.classList.toggle('hidden', visibles !== 0 || termino === '');
  });

  // --- Copiar al portapapeles con fallback (funciona incluso si
  //     navigator.clipboard no está disponible o es rechazado) ---
  async function copiarAlPortapapeles(texto: string): Promise<boolean> {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(texto);
        return true;
      } catch {
        // sigue al fallback de abajo
      }
    }
    try {
      const textarea = document.createElement('textarea');
      textarea.value = texto;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      const exito = document.execCommand('copy');
      textarea.remove();
      return exito;
    } catch {
      return false;
    }
  }

  // --- Botón/card copiar con animación + notificación (delegación de eventos) ---
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // Botón "Eliminar" (solo visible para administradores). Se revisa
    // primero porque está DENTRO de la card clickeable: si no
    // cortamos aquí, también dispararía la lógica de copiado de abajo.
    const deleteBtn = target.closest('[data-delete-centro]') as HTMLElement | null;
    if (deleteBtn) {
      const id = deleteBtn.dataset.deleteCentro;

      const confirmacion = await Swal.fire({
        title: '¿Eliminar este centro educativo?',
        text: 'Esta acción no se puede deshacer.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar',
        confirmButtonColor: '#dc2626',
      });

      if (!confirmacion.isConfirmed) return;

      const res = await fetch(`/api/centros-escolares/${id}`, { method: 'DELETE' });

      if (res.ok) {
        deleteBtn.closest('article')?.remove();
        Toast.fire({ icon: 'success', title: 'Centro eliminado' });
      } else {
        Toast.fire({ icon: 'error', title: 'No se pudo eliminar el centro' });
      }
      return;
    }

    const btn = target.closest('[data-copy-btn]') as HTMLElement | null;
    const card = target.closest('[data-centro-card]') as HTMLElement | null;
    if (!btn && !card) return;

    // Si se hizo click en cualquier parte de la card, usamos sus datos
    // (aunque el click haya sido directo sobre el botón interno).
    const origen = btn ?? card!;
    const texto = origen.dataset.copyText ?? card?.querySelector('[data-copy-btn]')?.getAttribute('data-copy-text') ?? '';

    const exito = await copiarAlPortapapeles(texto);
    if (!exito) {
      Toast.fire({ icon: 'error', title: 'No se pudo copiar' });
      return;
    }

    // Flash verde momentáneo en toda la card.
    if (card) {
      card.classList.add('bg-emerald-50', 'border-emerald-300');
      setTimeout(() => {
        card.classList.remove('bg-emerald-50', 'border-emerald-300');
      }, 600);
    }

    // Si el click fue directo sobre el botón, además animamos su ícono.
    if (btn) {
      const iconCopy = btn.querySelector('[data-icon-copy]');
      const iconCheck = btn.querySelector('[data-icon-check]');
      iconCopy?.classList.add('opacity-0', 'scale-50');
      iconCheck?.classList.remove('opacity-0', 'scale-50');
      setTimeout(() => {
        iconCopy?.classList.remove('opacity-0', 'scale-50');
        iconCheck?.classList.add('opacity-0', 'scale-50');
      }, 1500);
    }

    Toast.fire({ icon: 'success', title: 'Copiado exitosamente' });
  });
</script>