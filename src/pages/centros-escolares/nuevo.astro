---
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import '../../styles/global.css';

const url = new URL(Astro.request.url);
const errorMessage = url.searchParams.get('error');
---

<DashboardLayout title="Nuevo centro">
  <div class="max-w-xl mx-auto">
    <div class="mb-6">
      <a href="/centros-escolares" class="inline-flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Volver a centros escolares
      </a>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100">Nuevo centro educativo</h1>
    </div>

    <form method="POST" action="/api/centros-escolares" class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 space-y-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="cod">
          Código
        </label>
        <input
          id="cod"
          name="cod"
          type="number"
          required
          placeholder="10345"
          class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-slate-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="nombre">
          Nombre del centro
        </label>
        <input
          id="nombre"
          name="nombre"
          type="text"
          required
          placeholder="Centro Escolar..."
          class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-slate-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900"
        />
      </div>

      {errorMessage && (
        <div class="rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 px-4 py-3 text-sm text-red-700 dark:text-red-400">
          {errorMessage}
        </div>
      )}

      <div class="flex gap-3 pt-2">
        <a
          href="/centros-escolares"
          class="flex-1 text-center rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-sm font-medium px-4 py-2.5 hover:bg-slate-50 dark:hover:bg-slate-800 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="flex-1 rounded-xl bg-slate-900 dark:bg-cyan-600 text-white text-sm font-medium px-4 py-2.5 hover:bg-slate-800 dark:hover:bg-cyan-500 transition"
        >
          Crear centro
        </button>
      </div>
    </form>
  </div>
</DashboardLayout>