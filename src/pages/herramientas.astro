---
export const prerender = false;

import DashboardLayout from '../layouts/DashboardLayout.astro';
import './src/styles/global.css'
const { supabase, isAdmin } = Astro.locals;

const { data, error } = await supabase
  .from('herramientas')
  .select('id, nombre, url')
  .order('nombre', { ascending: true });

function hostDe(url: string): string {
  try {
    return new URL(url).hostname;
  } catch {
    return '';
  }
}

// El favicon se obtiene a partir del dominio del enlace, usando el
// servicio público de favicons de Google (no hay que guardar nada extra).
const herramientas = (data ?? []).map((h) => {
  const host = hostDe(h.url);
  return {
    ...h,
    host,
    favicon: `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=128`,
  };
});

const inputClase =
  'w-full rounded-xl border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-800 px-4 py-2.5 text-sm text-slate-900 dark:text-zinc-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900';
---

<DashboardLayout title="Herramientas">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-cyan-400">Herramientas</h1>
        <p class="text-sm text-slate-500 dark:text-zinc-400 mt-0.5">Accesos directos a sitios y sistemas de uso frecuente</p>
      </div>

      {isAdmin && (
        <button
          id="btn-agregar-herramienta"
          type="button"
          class="inline-flex items-center justify-center gap-2 bg-slate-900 dark:bg-cyan-600 hover:bg-slate-800 dark:hover:bg-cyan-500 text-white text-sm font-medium px-4 py-2.5 rounded-lg transition-colors shrink-0"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Agregar herramienta
        </button>
      )}
    </div>

    {error && (
      <div class="mb-6 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 text-red-700 dark:text-red-400 text-sm rounded-lg px-4 py-3">
        No se pudieron cargar las herramientas.
      </div>
    )}

    {herramientas.length > 0 && (
      <div class="relative mb-6 max-w-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        <input
          id="buscador-herramientas"
          type="text"
          placeholder="Buscar herramienta..."
          class="w-full rounded-xl border border-slate-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 pl-10 pr-4 py-2.5 text-sm text-slate-900 dark:text-zinc-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900"
        />
      </div>
    )}

    <div id="grid-herramientas" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6 gap-4">
      {herramientas.map((h) => (
        <div
          class="group relative"
          data-herramienta-card
          data-nombre={h.nombre.toLowerCase()}
          data-host={h.host.toLowerCase()}
        >
          <a
            href={h.url}
            target="_blank"
            rel="noopener noreferrer"
            class="relative flex flex-col items-center justify-center gap-3 aspect-square rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4 text-center shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-cyan-400 dark:hover:border-cyan-500"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="absolute top-2.5 left-2.5 w-3.5 h-3.5 text-slate-300 dark:text-zinc-600 group-hover:text-cyan-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>

            <div class="w-14 h-14 rounded-xl bg-slate-50 dark:bg-zinc-800 flex items-center justify-center">
              <img
                src={h.favicon}
                alt=""
                width="32"
                height="32"
                loading="lazy"
                class="w-8 h-8 object-contain"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='block'"
              />
              <svg style="display:none" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-slate-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
              </svg>
            </div>

            <span class="text-sm font-medium text-slate-800 dark:text-zinc-100 leading-snug line-clamp-2 break-words">
              {h.nombre}
            </span>
          </a>

          {isAdmin && (
            <div class="absolute top-2 right-2 flex gap-1 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 sm:focus-within:opacity-100 transition-opacity">
              <button
                type="button"
                data-edit-herramienta
                data-id={h.id}
                data-nombre-original={h.nombre}
                data-url-original={h.url}
                aria-label={`Editar ${h.nombre}`}
                class="p-1.5 rounded-lg bg-white/90 dark:bg-zinc-800/90 border border-slate-200 dark:border-zinc-700 text-slate-500 dark:text-zinc-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
                </svg>
              </button>
              <button
                type="button"
                data-delete-herramienta
                data-id={h.id}
                data-nombre-original={h.nombre}
                aria-label={`Eliminar ${h.nombre}`}
                class="p-1.5 rounded-lg bg-white/90 dark:bg-zinc-800/90 border border-slate-200 dark:border-zinc-700 text-slate-500 dark:text-zinc-300 hover:text-red-600 dark:hover:text-red-400 transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                </svg>
              </button>
            </div>
          )}
        </div>
      ))}
    </div>

    <p id="sin-resultados" class="hidden text-center text-slate-500 dark:text-zinc-400 text-sm py-16">
      No se encontraron herramientas que coincidan con tu búsqueda.
    </p>

    {herramientas.length === 0 && !error && (
      <div class="flex flex-col items-center justify-center text-center py-20 px-4">
        <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-zinc-800 flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-slate-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75a4.5 4.5 0 0 1-4.884 4.484c-1.076-.091-2.264.071-2.95.904l-7.152 8.684a2.548 2.548 0 1 1-3.586-3.586l8.684-7.152c.833-.686.995-1.874.904-2.95a4.5 4.5 0 0 1 6.336-4.486l-3.276 3.276a3.004 3.004 0 0 0 2.25 2.25l3.276-3.276c.256.565.398 1.192.398 1.852Z M4.867 19.125h.008v.008h-.008v-.008Z" />
          </svg>
        </div>
        <p class="text-sm font-medium text-slate-700 dark:text-zinc-300 mb-1">Aún no hay herramientas</p>
        <p class="text-sm text-slate-500 dark:text-zinc-400">
          {isAdmin
            ? 'Agrega la primera con el botón "Agregar herramienta".'
            : 'Un administrador las agregará próximamente.'}
        </p>
      </div>
    )}
  </div>

  {isAdmin && (
    <div id="modal-herramienta" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 px-4" role="dialog" aria-modal="true" aria-labelledby="modal-herramienta-titulo">
      <div class="w-full max-w-md bg-white dark:bg-zinc-900 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-xl p-6">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-12 h-12 rounded-xl bg-slate-50 dark:bg-zinc-800 flex items-center justify-center shrink-0">
            <img id="preview-favicon" src="" alt="" class="w-7 h-7 object-contain hidden" />
            <svg id="preview-globo" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-slate-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
            </svg>
          </div>
          <div>
            <h2 id="modal-herramienta-titulo" class="text-lg font-semibold text-slate-900 dark:text-cyan-400">Agregar herramienta</h2>
            <p class="text-xs text-slate-500 dark:text-zinc-400">El ícono se obtiene automáticamente del enlace.</p>
          </div>
        </div>

        <form id="form-herramienta" class="space-y-4">
          <input type="hidden" id="herramienta-id" />

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-zinc-300 mb-2" for="herramienta-nombre">Nombre</label>
            <input id="herramienta-nombre" type="text" required maxlength="60" placeholder="Ej. Correo institucional" class={inputClase} />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-zinc-300 mb-2" for="herramienta-url">Enlace</label>
            <input id="herramienta-url" type="text" inputmode="url" required placeholder="https://ejemplo.com" class={inputClase} />
          </div>

          <div class="flex gap-3 pt-2">
            <button
              id="btn-cancelar-herramienta"
              type="button"
              class="flex-1 rounded-xl border border-slate-200 dark:border-zinc-700 text-slate-700 dark:text-zinc-300 text-sm font-medium px-4 py-2.5 hover:bg-slate-50 dark:hover:bg-zinc-800 transition"
            >
              Cancelar
            </button>
            <button
              id="btn-guardar-herramienta"
              type="submit"
              class="flex-1 rounded-xl bg-slate-900 dark:bg-cyan-600 text-white text-sm font-medium px-4 py-2.5 hover:bg-slate-800 dark:hover:bg-cyan-500 transition disabled:opacity-60 disabled:cursor-not-allowed"
            >
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  )}
</DashboardLayout>

<script>
  import Swal from 'sweetalert2';

  const Toast = Swal.mixin({
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 2500,
    timerProgressBar: true,
  });

  // --- Buscador (por nombre o dominio) ---
  const buscador = document.getElementById('buscador-herramientas') as HTMLInputElement | null;
  const grid = document.getElementById('grid-herramientas');
  const sinResultados = document.getElementById('sin-resultados');

  buscador?.addEventListener('input', () => {
    const termino = buscador.value.trim().toLowerCase();
    const cards = grid?.querySelectorAll<HTMLElement>('[data-herramienta-card]') ?? [];
    let visibles = 0;

    cards.forEach((card) => {
      const coincide =
        (card.dataset.nombre ?? '').includes(termino) || (card.dataset.host ?? '').includes(termino);
      card.classList.toggle('hidden', !coincide);
      if (coincide) visibles++;
    });

    sinResultados?.classList.toggle('hidden', visibles !== 0 || termino === '');
  });

  // --- Modal de agregar / editar (solo existe en el DOM para admins) ---
  const modal = document.getElementById('modal-herramienta');
  const form = document.getElementById('form-herramienta') as HTMLFormElement | null;
  const inputId = document.getElementById('herramienta-id') as HTMLInputElement | null;
  const inputNombre = document.getElementById('herramienta-nombre') as HTMLInputElement | null;
  const inputUrl = document.getElementById('herramienta-url') as HTMLInputElement | null;
  const titulo = document.getElementById('modal-herramienta-titulo');
  const btnGuardar = document.getElementById('btn-guardar-herramienta') as HTMLButtonElement | null;
  const previewImg = document.getElementById('preview-favicon') as HTMLImageElement | null;
  const previewGlobo = document.getElementById('preview-globo');

  function hostValido(valor: string): string | null {
    let v = valor.trim();
    if (!v) return null;
    if (!/^https?:\/\//i.test(v)) v = `https://${v}`;
    try {
      const host = new URL(v).hostname;
      return host.includes('.') ? host : null;
    } catch {
      return null;
    }
  }

  // Vista previa en vivo del favicon mientras se escribe el enlace.
  function actualizarPreview() {
    if (!previewImg || !previewGlobo || !inputUrl) return;
    const host = hostValido(inputUrl.value);
    if (host) {
      previewImg.src = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=128`;
      previewImg.classList.remove('hidden');
      previewGlobo.classList.add('hidden');
    } else {
      previewImg.classList.add('hidden');
      previewImg.removeAttribute('src');
      previewGlobo.classList.remove('hidden');
    }
  }

  function abrirModal(datos?: { id: string; nombre: string; url: string }) {
    if (!modal || !form || !inputId || !inputNombre || !inputUrl) return;
    inputId.value = datos?.id ?? '';
    inputNombre.value = datos?.nombre ?? '';
    inputUrl.value = datos?.url ?? '';
    if (titulo) titulo.textContent = datos ? 'Editar herramienta' : 'Agregar herramienta';
    actualizarPreview();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    inputNombre.focus();
  }

  function cerrarModal() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  let temporizadorPreview: number | undefined;
  inputUrl?.addEventListener('input', () => {
    window.clearTimeout(temporizadorPreview);
    temporizadorPreview = window.setTimeout(actualizarPreview, 350);
  });

  document.getElementById('btn-agregar-herramienta')?.addEventListener('click', () => abrirModal());
  document.getElementById('btn-cancelar-herramienta')?.addEventListener('click', cerrarModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) cerrarModal(); // clic fuera del cuadro
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarModal();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!inputId || !inputNombre || !inputUrl || !btnGuardar) return;

    const id = inputId.value;
    btnGuardar.disabled = true;
    btnGuardar.textContent = 'Guardando...';

    try {
      const res = await fetch(id ? `/api/herramientas/${id}` : '/api/herramientas', {
        method: id ? 'PATCH' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre: inputNombre.value, url: inputUrl.value }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        Toast.fire({ icon: 'error', title: data.error ?? 'No se pudo guardar la herramienta' });
        return;
      }

      cerrarModal();
      await Swal.fire({
        icon: 'success',
        title: id ? 'Herramienta actualizada' : 'Herramienta agregada',
        timer: 1200,
        showConfirmButton: false,
      });
      window.location.reload();
    } catch (err) {
      console.error(err);
      Toast.fire({ icon: 'error', title: 'Error de conexión' });
    } finally {
      btnGuardar.disabled = false;
      btnGuardar.textContent = 'Guardar';
    }
  });

  // --- Editar / eliminar (delegación de eventos) ---
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    const btnEditar = target.closest('[data-edit-herramienta]') as HTMLElement | null;
    if (btnEditar) {
      abrirModal({
        id: btnEditar.dataset.id ?? '',
        nombre: btnEditar.dataset.nombreOriginal ?? '',
        url: btnEditar.dataset.urlOriginal ?? '',
      });
      return;
    }

    const btnEliminar = target.closest('[data-delete-herramienta]') as HTMLElement | null;
    if (btnEliminar) {
      const id = btnEliminar.dataset.id;
      const nombre = btnEliminar.dataset.nombreOriginal ?? 'esta herramienta';

      const confirmacion = await Swal.fire({
        title: `¿Eliminar "${nombre}"?`,
        text: 'Esta acción no se puede deshacer.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar',
        confirmButtonColor: '#dc2626',
      });
      if (!confirmacion.isConfirmed) return;

      const res = await fetch(`/api/herramientas/${id}`, { method: 'DELETE' });
      if (res.ok) {
        btnEliminar.closest('[data-herramienta-card]')?.remove();
        Toast.fire({ icon: 'success', title: 'Herramienta eliminada' });
      } else {
        const data = await res.json().catch(() => ({}));
        Toast.fire({ icon: 'error', title: data.error ?? 'No se pudo eliminar' });
      }
    }
  });
</script>