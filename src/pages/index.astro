---
export const prerender = false;

import DashboardLayout from '../layouts/DashboardLayout.astro';
import TicketCard from '../components/TicketCard.astro';
import '../styles/global.css';

const { supabase } = Astro.locals;
const ZONA = 'America/El_Salvador';
const OFFSET = '-06:00';

const formatoClave = new Intl.DateTimeFormat('en-CA', {
  timeZone: ZONA,
  year: 'numeric',
  month: '2-digit',
});

// "2026-08" a partir de cualquier fecha/timestamp
function claveMes(fecha: Date | string): string {
  const partes = formatoClave.formatToParts(new Date(fecha));
  const anio = partes.find((p) => p.type === 'year')?.value;
  const mes = partes.find((p) => p.type === 'month')?.value;
  return `${anio}-${mes}`;
}

// Suma o resta meses a una clave "YYYY-MM"
function sumarMeses(clave: string, delta: number): string {
  const [a, m] = clave.split('-').map(Number);
  const d = new Date(Date.UTC(a, m - 1 + delta, 1));
  return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
}

// "2026-08" -> "Agosto 2026"
function etiquetaMes(clave: string): string {
  const [a, m] = clave.split('-').map(Number);
  const texto = new Date(Date.UTC(a, m - 1, 1))
    .toLocaleDateString('es-ES', { month: 'long', year: 'numeric', timeZone: 'UTC' })
    .replace(' de ', ' ');
  return texto.charAt(0).toUpperCase() + texto.slice(1);
}

// "2026-08" -> "Agosto" (solo el nombre, para el menú agrupado por año)
function nombreMes(clave: string): string {
  const [a, m] = clave.split('-').map(Number);
  const texto = new Date(Date.UTC(a, m - 1, 1)).toLocaleDateString('es-ES', { month: 'long', timeZone: 'UTC' });
  return texto.charAt(0).toUpperCase() + texto.slice(1);
}

const mesActual = claveMes(new Date());
const parametroMes = Astro.url.searchParams.get('mes');
const mesSeleccionado =
  parametroMes && /^\d{4}-(0[1-9]|1[0-2])$/.test(parametroMes) ? parametroMes : mesActual;

const esMesActual = mesSeleccionado === mesActual;
const puedeAvanzar = mesSeleccionado < mesActual; // "YYYY-MM" se compara bien como texto
const mesAnterior = sumarMeses(mesSeleccionado, -1);
const mesSiguiente = sumarMeses(mesSeleccionado, 1);
const hrefMes = (clave: string) => (clave === mesActual ? '/' : `/?mes=${clave}`);

// Límites del mes: desde el día 1 a las 00:00 (El Salvador) hasta el día 1 del mes siguiente (exclusivo)
const inicioMes = `${mesSeleccionado}-01T00:00:00${OFFSET}`;
const finMes = `${mesSiguiente}-01T00:00:00${OFFSET}`;

const [ticketsRes, mesesRes, centrosRes] = await Promise.all([
  // Tickets del mes seleccionado (RLS: solo los del usuario)
  supabase
    .from('tickets')
    .select('id, noticket, codce, ce, fecha, usuario(tipo)')
    .gte('fecha', inicioMes)
    .lt('fecha', finMes)
    .order('fecha', { ascending: false }),

  // Todas las fechas del usuario, solo para saber qué meses tienen tickets
  supabase.from('tickets').select('fecha').order('fecha', { ascending: false }),

  // Total de centros educativos existentes en el directorio (no solo los del usuario)
  supabase.from('centroseducativos').select('*', { count: 'exact', head: true }),
]);

// Opciones del selector: meses con tickets + mes actual + mes seleccionado, con su conteo
const conteoPorMes = new Map<string, number>();
for (const fila of mesesRes.data ?? []) {
  const clave = claveMes(fila.fecha);
  conteoPorMes.set(clave, (conteoPorMes.get(clave) ?? 0) + 1);
}
conteoPorMes.set(mesActual, conteoPorMes.get(mesActual) ?? 0);
conteoPorMes.set(mesSeleccionado, conteoPorMes.get(mesSeleccionado) ?? 0);

const opcionesMes = Array.from(conteoPorMes.entries())
  .sort(([a], [b]) => b.localeCompare(a))
  .map(([clave, total]) => ({ clave, total, etiqueta: etiquetaMes(clave) }));

// Agrupa las opciones por año para el menú desplegable
const gruposAnio: { anio: string; meses: { clave: string; nombre: string; total: number }[] }[] = [];
for (const o of opcionesMes) {
  const anio = o.clave.slice(0, 4);
  let grupo = gruposAnio.find((g) => g.anio === anio);
  if (!grupo) {
    grupo = { anio, meses: [] };
    gruposAnio.push(grupo);
  }
  grupo.meses.push({ clave: o.clave, nombre: nombreMes(o.clave), total: o.total });
}

// =========================================================
// Tickets del mes y tarjetas de resumen
// =========================================================
const error = ticketsRes.error;

const tickets = (ticketsRes.data ?? []).map((t: any) => ({
  id: t.id,
  noticket: t.noticket,
  codce: t.codce,
  ce: t.ce,
  fecha: t.fecha,
  tipoUsuario: (t.usuario?.tipo ?? 'Estudiante') as 'Estudiante' | 'Docente',
}));

const totalCentros = centrosRes.count ?? 0;

// Aquí agregamos los SVG nativos a cada tarjeta
const resumen = [
  { 
    label: 'Total del mes', 
    valor: tickets.length, 
    color: 'text-slate-900 dark:text-zinc-100',
    iconColor: 'text-slate-500 dark:text-zinc-400',
    iconBg: 'bg-slate-100 dark:bg-zinc-800/80',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" /></svg>`
  },
  {
    label: 'Estudiantes',
    valor: tickets.filter((t) => t.tipoUsuario === 'Estudiante').length,
    color: 'text-indigo-600 dark:text-indigo-400',
    iconColor: 'text-indigo-600 dark:text-indigo-400',
    iconBg: 'bg-indigo-50 dark:bg-indigo-900/20',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" /></svg>`
  },
  {
    label: 'Docentes',
    valor: tickets.filter((t) => t.tipoUsuario === 'Docente').length,
    color: 'text-teal-600 dark:text-teal-400',
    iconColor: 'text-teal-600 dark:text-teal-400',
    iconBg: 'bg-teal-50 dark:bg-teal-900/20',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" /></svg>`
  },
  { 
    label: 'Centros Escolares', 
    valor: totalCentros, 
    color: 'text-slate-900 dark:text-zinc-100', 
    nota: 'registrados en total',
    iconColor: 'text-purple-600 dark:text-purple-400',
    iconBg: 'bg-purple-50 dark:bg-purple-900/20',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" /></svg>`
  },
];

const botonFlecha =
  'inline-flex items-center justify-center w-9 h-[38px] text-slate-500 dark:text-zinc-400 hover:bg-slate-50 dark:hover:bg-zinc-800 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors';
---

<DashboardLayout title="Tickets">
  <div class="max-w-7xl mx-auto">
    <!-- Encabezado + selector de mes -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-cyan-400 uppercase">Tickets</h1>
        <p class="text-sm text-slate-500 dark:text-zinc-400 mt-0.5">
          {etiquetaMes(mesSeleccionado)}{esMesActual ? ' · mes actual' : ''}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <div class="inline-flex items-stretch rounded-xl border border-slate-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 shadow-sm divide-x divide-slate-200 dark:divide-zinc-700">
          <a href={hrefMes(mesAnterior)} aria-label="Mes anterior" title="Mes anterior" class={`${botonFlecha} rounded-l-xl`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </a>

          <details id="selector-mes" class="relative">
            <summary class="flex items-center gap-2.5 h-[38px] px-3.5 cursor-pointer select-none text-sm font-semibold text-slate-800 dark:text-zinc-100 hover:bg-slate-50 dark:hover:bg-zinc-800 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-500 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
              </svg>
              <span>{etiquetaMes(mesSeleccionado)}</span>
              <span class="rounded-full bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-400 text-[11px] font-semibold px-2 py-0.5 tabular-nums">
                {tickets.length}
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" class="chevron-mes w-3.5 h-3.5 text-slate-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>

            <div class="panel-mes absolute left-0 top-full mt-2 z-30 w-64 max-h-80 overflow-y-auto rounded-xl border border-slate-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 shadow-xl dark:shadow-black/40 p-1.5">
              {gruposAnio.map((grupo) => (
                <div>
                  <p class="px-2.5 pt-2 pb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-zinc-500">
                    {grupo.anio}
                  </p>
                  {grupo.meses.map((o) => {
                    const activo = o.clave === mesSeleccionado;
                    return (
                      <a
                        href={hrefMes(o.clave)}
                        class:list={[
                          'flex items-center justify-between gap-3 rounded-lg px-2.5 py-2 text-sm transition-colors',
                          activo
                            ? 'bg-cyan-50 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-400 font-semibold'
                            : 'text-slate-700 dark:text-zinc-300 hover:bg-slate-50 dark:hover:bg-zinc-800',
                        ]}
                      >
                        <span>{o.nombre}</span>
                        <span class="flex items-center gap-1.5">
                          <span
                            class:list={[
                              'min-w-[1.5rem] text-center rounded-full text-[11px] font-semibold px-2 py-0.5 tabular-nums',
                              activo
                                ? 'bg-cyan-100 dark:bg-cyan-900/50 text-cyan-700 dark:text-cyan-300'
                                : 'bg-slate-100 dark:bg-zinc-800 text-slate-500 dark:text-zinc-400',
                            ]}
                          >
                            {o.total}
                          </span>
                          {activo && (
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                            </svg>
                          )}
                        </span>
                      </a>
                    );
                  })}
                </div>
              ))}
            </div>
          </details>

          {puedeAvanzar ? (
            <a href={hrefMes(mesSiguiente)} aria-label="Mes siguiente" title="Mes siguiente" class={`${botonFlecha} rounded-r-xl`}>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </a>
          ) : (
            <span aria-hidden="true" class={`${botonFlecha} rounded-r-xl opacity-40 cursor-not-allowed hover:bg-transparent dark:hover:bg-transparent hover:text-slate-500 dark:hover:text-zinc-400`}>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </span>
          )}
        </div>

        {!esMesActual && (
          <a href="/" class="inline-flex items-center gap-1.5 h-10 rounded-xl border border-cyan-200 dark:border-cyan-900 bg-cyan-50 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-400 text-sm font-medium px-3.5 hover:bg-cyan-100 dark:hover:bg-cyan-950/70 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
            </svg>
            Mes actual
          </a>
        )}

        <a href="/tickets/nuevo" class="inline-flex items-center justify-center gap-2 h-10 bg-slate-900 dark:bg-cyan-600 hover:bg-slate-800 dark:hover:bg-cyan-500 text-white text-sm font-medium px-4 rounded-xl shadow-sm transition-colors shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Nuevo ticket
        </a>
      </div>
    </div>

    {error && (
      <div class="mb-6 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 text-red-700 dark:text-red-400 text-sm rounded-lg px-4 py-3">
        No se pudieron cargar los tickets. Revisa la conexión con Supabase y los permisos (RLS) de la tabla.
      </div>
    )}

    <!-- Resumen del mes con nuevo diseño visual -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      {resumen.map((item) => (
        <div class="bg-white dark:bg-zinc-900 rounded-xl border border-slate-200 dark:border-zinc-800 p-5 flex items-center justify-between shadow-sm">
          <div>
            <p class="text-xs font-semibold text-slate-500 dark:text-zinc-400 uppercase tracking-wider">{item.label}</p>
            <p class:list={['text-3xl sm:text-4xl font-extrabold tracking-tight mt-1', item.color]}>{item.valor}</p>
            {item.nota && <p class="text-[11px] text-slate-400 dark:text-zinc-500 mt-1">{item.nota}</p>}
          </div>
          <div class:list={['p-3 rounded-full flex items-center justify-center', item.iconBg, item.iconColor]} set:html={item.icon} />
        </div>
      ))}
    </div>

    {tickets.length > 0 && (
      <div class="relative mb-6 max-w-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        <input
          id="buscador-tickets"
          type="text"
          inputmode="numeric"
          placeholder="Buscar por número de ticket..."
          class="w-full rounded-xl border border-slate-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 pl-10 pr-4 py-2.5 text-sm text-slate-900 dark:text-zinc-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900"
        />
      </div>
    )}

    <!-- Grid de tickets del mes (Ahora adaptado a xl:grid-cols-4) -->
    <div id="grid-tickets" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {tickets.map((ticket) => (
        <div data-ticket-wrapper data-noticket={ticket.noticket}>
          <TicketCard
            id={ticket.id}
            numTicket={ticket.noticket}
            tipoUsuario={ticket.tipoUsuario}
            centroEducativo={ticket.ce}
            codce={ticket.codce}
            fecha={ticket.fecha}
          />
        </div>
      ))}
    </div>

    <p id="sin-resultados" class="hidden text-center text-slate-500 dark:text-zinc-400 text-sm py-16">
      No hay tickets con ese número en {etiquetaMes(mesSeleccionado)}.
    </p>

    {tickets.length === 0 && !error && (
      <div class="flex flex-col items-center justify-center text-center py-20 px-4">
        <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-zinc-800 flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-slate-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
        </div>
        <p class="text-sm font-medium text-slate-700 dark:text-zinc-300 mb-1">
          No hay tickets en {etiquetaMes(mesSeleccionado)}
        </p>
        <p class="text-sm text-slate-500 dark:text-zinc-400">
          {esMesActual
            ? 'Crea tu primer ticket del mes con el botón "Nuevo ticket".'
            : 'Elige otro mes en el selector para ver sus tickets.'}
        </p>
      </div>
    )}
  </div>
</DashboardLayout>

<script>
  // Menú de meses: se cierra al hacer clic fuera o al presionar Escape.
  const selectorMes = document.getElementById('selector-mes') as HTMLDetailsElement | null;

  document.addEventListener('click', (e) => {
    if (selectorMes?.open && !selectorMes.contains(e.target as Node)) selectorMes.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && selectorMes?.open) selectorMes.open = false;
  });

  // Buscador por número de ticket (dentro del mes que se está viendo).
  const buscador = document.getElementById('buscador-tickets') as HTMLInputElement | null;
  const grid = document.getElementById('grid-tickets');
  const sinResultados = document.getElementById('sin-resultados');

  const limpiar = (valor: string) => valor.trim().toLowerCase().replace(/^#/, '');

  buscador?.addEventListener('input', () => {
    const termino = limpiar(buscador.value);
    const envoltorios = grid?.querySelectorAll<HTMLElement>('[data-ticket-wrapper]') ?? [];
    let visibles = 0;

    envoltorios.forEach((el) => {
      const coincide = limpiar(el.dataset.noticket ?? '').includes(termino);
      el.classList.toggle('hidden', !coincide);
      if (coincide) visibles++;
    });

    sinResultados?.classList.toggle('hidden', visibles !== 0 || termino === '');
  });
</script>

