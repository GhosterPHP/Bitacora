---
export const prerender = false;

import "../styles/global.css";

const url = new URL(Astro.request.url);
const errorMessage = url.searchParams.get('error');
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Misma lógica que en el dashboard: respeta el tema guardado,
      // para que el login no "salte" de claro a oscuro al navegar.
      (function () {
        const guardado = localStorage.getItem('tema');
        const prefiereOscuro = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const oscuro = guardado ? guardado === 'oscuro' : prefiereOscuro;
        document.documentElement.classList.toggle('dark', oscuro);
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    <div class="min-h-screen flex items-center justify-center bg-gradient-to-b from-slate-50 to-slate-100 dark:from-slate-950 dark:to-slate-900 px-4 py-12">
      <div class="w-full max-w-md">
        <!-- Marca -->
        <div class="flex flex-col items-center mb-8">
          <h1 class="text-xl font-semibold text-slate-900 dark:text-white">Bitacora de Actividades</h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Ingresa a tu cuenta para continuar</p>
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-8 shadow-sm">
          <form method="POST" action="/api/session" class="space-y-5" id="form-login">
            <!-- Email -->
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="email">
                Correo electrónico
              </label>
              <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="tucorreo@ejemplo.com"
                  class="w-full rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 pl-11 pr-4 py-3 text-sm text-slate-900 dark:text-slate-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900"
                />
              </div>
            </div>

            <!-- Password -->
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="password">
                Contraseña
              </label>
              <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  autocomplete="current-password"
                  placeholder="••••••••"
                  class="w-full rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 pl-11 pr-11 py-3 text-sm text-slate-900 dark:text-slate-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900"
                />
                <button
                  type="button"
                  id="toggle-password"
                  aria-label="Mostrar contraseña"
                  class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors"
                >
                  <svg id="icono-ojo" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg id="icono-ojo-cerrado" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
            </div>

            {errorMessage && (
              <div class="flex items-start gap-2.5 rounded-2xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 px-4 py-3 text-sm text-red-700 dark:text-red-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                <span>{errorMessage}</span>
              </div>
            )}

            <button
              id="btn-submit"
              class="w-full flex items-center justify-center gap-2 rounded-2xl bg-slate-900 dark:bg-cyan-600 text-white text-sm font-medium px-4 py-3 hover:bg-slate-800 dark:hover:bg-cyan-500 transition"
              type="submit"
            >
              <svg id="icono-loading" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              <span id="texto-submit">Entrar</span>
            </button>
          </form>
        </div>

        <p class="text-center text-xs text-slate-400 dark:text-slate-600 mt-6">
          Sistema de Tickets · Bitácora
        </p>
      </div>
    </div>

    <script>
      // Mostrar/ocultar contraseña
      const togglePassword = document.getElementById('toggle-password');
      const passwordInput = document.getElementById('password') as HTMLInputElement | null;
      const iconoOjo = document.getElementById('icono-ojo');
      const iconoOjoCerrado = document.getElementById('icono-ojo-cerrado');

      togglePassword?.addEventListener('click', () => {
        if (!passwordInput) return;
        const esTexto = passwordInput.type === 'text';
        passwordInput.type = esTexto ? 'password' : 'text';
        iconoOjo?.classList.toggle('hidden', !esTexto);
        iconoOjoCerrado?.classList.toggle('hidden', esTexto);
      });

      // Estado de carga en el botón al enviar (feedback mientras
      // Supabase valida las credenciales)
      const form = document.getElementById('form-login');
      const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement | null;
      const iconoLoading = document.getElementById('icono-loading');
      const textoSubmit = document.getElementById('texto-submit');

      form?.addEventListener('submit', () => {
        if (btnSubmit) btnSubmit.disabled = true;
        iconoLoading?.classList.remove('hidden');
        if (textoSubmit) textoSubmit.textContent = 'Ingresando...';
      });
    </script>
  </body>
</html>