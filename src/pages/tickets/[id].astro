---
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import '../../styles/global.css';
const { supabase } = Astro.locals;
const { id } = Astro.params;

const url = new URL(Astro.request.url);
const errorMessage = url.searchParams.get('error');

// RLS filtra automáticamente: si el ticket no es del usuario logueado,
// esta consulta no devuelve nada (data = null), como si no existiera.
const { data: ticket, error } = await supabase
  .from('tickets')
  .select('id, noticket, codce, ce, usuario(tipo)')
  .eq('id', id)
  .single();

if (error || !ticket) {
  return Astro.redirect('/?error=' + encodeURIComponent('Ticket no encontrado.'));
}

const tipoUsuarioActual = (ticket.usuario as any)?.tipo ?? 'Estudiante';
---

<DashboardLayout title="Editar ticket">
  <div class="max-w-xl mx-auto">
    <div class="mb-6">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Volver a tickets
      </a>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100">Editar ticket</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">{ticket.noticket}</p>
    </div>

    <form id="form-editar" data-ticket-id={ticket.id} class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 space-y-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="noticket">
          Número de ticket
        </label>
        <input
          id="noticket"
          name="noticket"
          type="text"
          required
          value={ticket.noticket}
          class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-slate-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="tipoUsuario">
          Tipo de usuario
        </label>
        <select
          id="tipoUsuario"
          name="tipoUsuario"
          required
          class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-slate-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900"
        >
          <option value="Estudiante" selected={tipoUsuarioActual === 'Estudiante'}>Estudiante</option>
          <option value="Docente" selected={tipoUsuarioActual === 'Docente'}>Docente</option>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="codce">
            Código de centro
          </label>
          <input
            id="codce"
            name="codce"
            type="number"
            required
            value={ticket.codce}
            class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-slate-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="ce">
            Nombre del centro
          </label>
          <input
            id="ce"
            name="ce"
            type="text"
            required
            value={ticket.ce}
            class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-2.5 text-sm text-slate-900 dark:text-slate-100 outline-none transition focus:border-cyan-400 focus:ring-2 focus:ring-cyan-200 dark:focus:ring-cyan-900"
          />
        </div>
      </div>

      {errorMessage && (
        <div class="rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 px-4 py-3 text-sm text-red-700 dark:text-red-400">
          {errorMessage}
        </div>
      )}

      <div class="flex gap-3 pt-2">
        <a
          href="/"
          class="flex-1 text-center rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-sm font-medium px-4 py-2.5 hover:bg-slate-50 dark:hover:bg-slate-800 transition"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="flex-1 rounded-xl bg-slate-900 dark:bg-cyan-600 text-white text-sm font-medium px-4 py-2.5 hover:bg-slate-800 dark:hover:bg-cyan-500 transition"
        >
          Guardar cambios
        </button>
      </div>
    </form>
  </div>
</DashboardLayout>

<script>
  // El endpoint usa PATCH, y un <form> HTML normal solo soporta
  // GET/POST, así que interceptamos el submit y mandamos el
  // método correcto vía fetch.
  const form = document.getElementById('form-editar') as HTMLFormElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = form.dataset.ticketId;
    const formData = new FormData(form);

    const res = await fetch(`/api/tickets/${id}`, {
      method: 'PATCH',
      body: formData,
    });

    if (res.redirected) {
      window.location.href = res.url;
    } else {
      window.location.href = '/';
    }
  });
</script>